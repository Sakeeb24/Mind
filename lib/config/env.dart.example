/// Environment configuration for MindSpace
///
/// Copy this file to `env.dart` and fill in your values.
/// NEVER commit env.dart to version control.
///
/// Build with:
///   flutter run --dart-define=PUTER_AUTH_TOKEN=your_token_here
///   flutter run --dart-define=AI_MODEL=gpt-4o-mini
class Env {
  // ──────────────────────────────────────────────────────
  // Puter Configuration
  // ──────────────────────────────────────────────────────

  /// Puter auth token — obtain from https://puter.com/dashboard → Create token
  /// Used for Puter AI (OpenAI-compatible endpoint) and cloud storage/KV.
  static const String puterAuthToken = String.fromEnvironment(
    'PUTER_AUTH_TOKEN',
    defaultValue: '',
  );

  /// Puter API base URL for OpenAI-compatible AI requests.
  static const String puterAiBaseUrl = 'https://api.puter.com/puterai/openai/v1';

  /// Puter REST API base URL for auth, storage, and KV operations.
  static const String puterApiBaseUrl = 'https://api.puter.com';

  // ──────────────────────────────────────────────────────
  // AI Configuration
  // ──────────────────────────────────────────────────────

  /// Default AI model for chat, summarization, etc.
  /// Puter supports: gpt-4o-mini, gpt-4o, claude-sonnet-5, gemini-3.5-flash-lite, grok-4.6, etc.
  static const String defaultAiModel = String.fromEnvironment(
    'AI_MODEL',
    defaultValue: 'gpt-4o-mini',
  );

  /// Daily AI query limit per user (client-side tracking).
  static const int freeDailyQueryLimit = 20;

  /// AI response timeout in seconds.
  static const int aiResponseTimeoutSeconds = 30;

  // ──────────────────────────────────────────────────────
  // App Configuration
  // ──────────────────────────────────────────────────────

  /// Maximum file size for PDF uploads (in bytes). Default: 50MB.
  static const int maxFileSizeBytes = 50 * 1024 * 1024;

  /// Maximum number of pages per document. Default: 200.
  static const int maxPageCount = 200;

  /// Maximum undo/redo stack depth. Default: 50.
  static const int maxUndoDepth = 50;

  /// Maximum characters per sticky note. Default: 500.
  static const int maxNoteLength = 500;

  /// Maximum characters per chat message. Default: 2000.
  static const int maxChatMessageLength = 2000;

  /// Maximum characters per folder name. Default: 50.
  static const int maxFolderNameLength = 50;

  /// PDF page cache size (number of pages to keep in memory). Default: 10.
  static const int pdfPageCacheSize = 10;

  /// Thumbnail generation max width. Default: 200 pixels.
  static const int thumbnailMaxWidth = 200;

  /// Thumbnail generation max height. Default: 280 pixels.
  static const int thumbnailMaxHeight = 280;
}
