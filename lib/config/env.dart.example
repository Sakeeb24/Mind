/// Environment configuration for MindSpace
///
/// Copy this file to `env.dart` and fill in your values.
/// NEVER commit env.dart to version control.
///
/// Usage:
///   static const String supabaseUrl = String.fromEnvironment(
///     'SUPABASE_URL',
///     defaultValue: 'YOUR_SUPABASE_URL',
///   );
class Env {
  // ──────────────────────────────────────────────────────
  // Supabase Configuration
  // ──────────────────────────────────────────────────────

  /// Your Supabase project URL
  /// Found in: Supabase Dashboard → Settings → API → Project URL
  static const String supabaseUrl = String.fromEnvironment(
    'SUPABASE_URL',
    defaultValue: 'https://your-project.supabase.co',
  );

  /// Your Supabase anonymous (public) key
  /// Found in: Supabase Dashboard → Settings → API → anon public
  /// This key is safe to include in the app — row-level security protects user data
  static const String supabaseAnonKey = String.fromEnvironment(
    'SUPABASE_ANON_KEY',
    defaultValue: 'your-anon-key-here',
  );

  // ──────────────────────────────────────────────────────
  // NVIDIA Nemotron API
  // ──────────────────────────────────────────────────────
  //
  // ⚠️  IMPORTANT: NVIDIA API keys are NEVER stored in the mobile app.
  // They are stored as Supabase Edge Function secrets and accessed
  // server-side only. See README.md for setup instructions.
  //
  // To set Edge Function secrets:
  //   supabase secrets set NEMOTRON_PARSE_API_KEY=your_key_here
  //   supabase secrets set NEMOTRON_ULTRA_API_KEY=your_key_here

  // ──────────────────────────────────────────────────────
  // Google OAuth
  // ──────────────────────────────────────────────────────
  //
  // Google OAuth Client IDs are configured in platform-specific files:
  //   - Android: android/app/build.gradle
  //   - iOS: ios/Runner/Info.plist
  //
  // See README.md Step 5 for Google OAuth setup instructions.

  // ──────────────────────────────────────────────────────
  // App Configuration
  // ──────────────────────────────────────────────────────

  /// Maximum file size for PDF uploads (in bytes)
  /// Default: 50MB
  static const int maxFileSizeBytes = 50 * 1024 * 1024;

  /// Maximum number of pages per document
  /// Default: 200
  static const int maxPageCount = 200;

  /// Maximum undo/redo stack depth
  /// Default: 50
  static const int maxUndoDepth = 50;

  /// Maximum characters per sticky note
  /// Default: 500
  static const int maxNoteLength = 500;

  /// Maximum characters per chat message
  /// Default: 2000
  static const int maxChatMessageLength = 2000;

  /// Maximum characters per folder name
  /// Default: 50
  static const int maxFolderNameLength = 50;

  /// Daily AI query limit for free tier
  /// Default: 20
  static const int freeDailyQueryLimit = 20;

  /// AI response timeout in seconds
  /// Default: 30
  static const int aiResponseTimeoutSeconds = 30;

  /// PDF page cache size (number of pages to keep in memory)
  /// Default: 10
  static const int pdfPageCacheSize = 10;

  /// Thumbnail generation max width
  /// Default: 200 pixels
  static const int thumbnailMaxWidth = 200;

  /// Thumbnail generation max height
  /// Default: 280 pixels
  static const int thumbnailMaxHeight = 280;

  // ──────────────────────────────────────────────────────
  // API Endpoints (Supabase Edge Functions)
  // ──────────────────────────────────────────────────────

  /// Edge Function base URL
  /// Automatically derived from supabaseUrl
  static String get edgeFunctionBase =>
      '${supabaseUrl}/functions/v1';

  /// Text extraction endpoint
  static String get extractTextEndpoint =>
      '$edgeFunctionBase/extract-text';

  /// Summarization endpoint
  static String get summarizeEndpoint =>
      '$edgeFunctionBase/summarize';

  /// Chat endpoint
  static String get chatEndpoint =>
      '$edgeFunctionBase/chat';

  /// Rate limit check endpoint
  static String get rateLimitEndpoint =>
      '$edgeFunctionBase/rate-limit';
}
